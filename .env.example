# PayQuant Environment Configuration Example
PQN_NETWORK=mainnet
PQN_P2P_PORT=28333
PQN_RPC_PORT=28332
PQN_RPC_USER=pqnrpc
PQN_RPC_PASS=change_me_to_a_secure_password
PQN_MINING_THREADS=4
PQN_QUANTUM_AUDIT_INTERVAL=3600

# ---------------------------------------------------------------------------
# Quantum TRNG (v2.0.0-quantum) — desktop-only, gitignored
# COPY this file to `.env` on the DESKTOP ONLY. `.env` is gitignored — never
# commit it. These keys are used solely by the local TRNG client; they never
# leave the machine and are never present in the repository.
# ---------------------------------------------------------------------------

# Cisco (Outshift) Quantum Random Number Generator — REST
# Get a key from https://developer.cisco.com/site/quantum-random-number-generator/
OUTSHIFT_API_KEY=your_outshift_api_key_here

# TRNG source preference: outshift | anu | auto (os.urandom fallback)
TRNG_SOURCE=anu
