# PayQuant (PQN) Example Network Configuration

server=1
daemon=1
port=28333
rpcport=28332
rpcuser=pqnrpc
rpcpassword=change_me_to_a_secure_password

# Post-Quantum & Consensus Parameters
post_quantum_sig=mldsa65
synergeia_consensus=1
target_spacing=15
active_validators=27

# Security Sentinel
warmup_period=10000
quantum_sentinel=1
